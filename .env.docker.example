# Docker deployment environment for docker-compose.yml
# Copy this file to .env.docker and adjust values if needed.

SECRET_KEY=change-me-before-deploy
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=False

DB_NAME=room_booking_backup
DB_USER=rith
DB_PASSWORD=rith1234
DB_HOST=db
DB_PORT=3306

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AI_ENABLED=False

# Optional local superuser auto-creation on first container start
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisPassword123!
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Optional integrations (leave blank if unused)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
HF_API_KEY=
HF_MODEL=microsoft/DialoGPT-medium
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Room Booking System <noreply@example.com>
ADMIN_EMAIL=admin@example.com
